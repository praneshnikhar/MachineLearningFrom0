# Copy this file to `.env` and fill in your values.
# Everything here is optional — the pipeline works without Slack.

# Slack incoming webhook URL (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Monthly budget per category (INR). Used by the budget watchdog.
# Format: "Category=amount;Category=amount"
MONTHLY_BUDGETS=Groceries=8000;Food & Dining=5000;Transport=3000;Utilities=4000;Shopping=5000;Entertainment=2000;Health=2000;Subscriptions=1500;Travel=6000;Rent=20000
